{
  "name": "cadre",
  "version": "0.1.0",
  "private": true,
  "description": "Sovereign parent AI operating platform for the Cho Zen Dell ecosystem.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "npm run db:prepare",
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ai:live": "NODE_ENV=development RUN_AI_GATEWAY_LIVE_TEST=true vitest run tests/integration/ai-gateway-live.test.ts",
    "ai:gateway:install": "tsx scripts/install-litellm.ts",
    "ai:gateway:start": "tsx scripts/start-litellm.ts",
    "db:prepare": "npm run db:migrate && npm run db:seed",
    "db:prepare:e2e": "tsx scripts/prepare-e2e.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-workspaces.ts",
    "owner:create": "tsx scripts/bootstrap-owner.ts",
    "verify:env": "tsx scripts/verify-env.ts",
    "verify:secrets": "tsx scripts/scan-secrets.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verify:secrets && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.7",
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
