# Install as /opt/lanseir/secrets/cadre.env with owner root:root and mode 0600.
# Never commit the populated file.
CADRE_DB_PASSWORD=replace_with_a_strong_unique_password
CADRE_DATABASE_URL=postgresql+psycopg://cadre:replace_with_url_encoded_password@db:5432/cadre
CADRE_PUBLIC_HOST=cadre.example.com
CADRE_ACME_EMAIL=operations@example.com
CADRE_API_TOKENS_JSON={"mission_control":"replace_with_32_plus_random_characters","al":"replace_with_32_plus_random_characters","invictus":"replace_with_32_plus_random_characters","porter":"replace_with_32_plus_random_characters","griot":"replace_with_32_plus_random_characters","sentinel":"replace_with_32_plus_random_characters"}
