# Local development only. Copy to .env; never commit populated credentials.
CADRE_ENV=development
CADRE_APP_NAME=LANSEIR
CADRE_DATABASE_URL=sqlite:///./cadre.db
CADRE_OPERATIONS_STATE_PATH=/tmp/lanseir-mission-control.json
CADRE_RELEASE_ID=development
CADRE_API_TOKENS_JSON={"mission_control":"replace_with_32_plus_random_characters","al":"replace_with_32_plus_random_characters","invictus":"replace_with_32_plus_random_characters","porter":"replace_with_32_plus_random_characters","griot":"replace_with_32_plus_random_characters","sentinel":"replace_with_32_plus_random_characters"}
CADRE_PUBLIC_URL=http://127.0.0.1:8000
CADRE_ADMIN_EMAILS=owner@example.com
CADRE_SUPPORT_EMAIL=support@example.com
CADRE_EXPOSE_DEVELOPMENT_TOKENS=false
CADRE_AI_PROVIDER=local
CADRE_AI_MODEL=lanseir-reflection-v1
CADRE_AI_BASE_URL=https://litellm.internal/v1
CADRE_AI_API_KEY=
