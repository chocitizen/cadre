# CADRE selects an embedded PostgreSQL-compatible store locally when DATABASE_URL is absent.
# Production should use a private PostgreSQL connection string.
DATABASE_URL=
CADRE_DB_PATH=./data/cadre

# Server-only CADRE AI gateway configuration. Never prefix these with NEXT_PUBLIC_.
CADRE_AI_PROVIDER=litellm
CADRE_AI_GATEWAY_URL=http://127.0.0.1:4000
CADRE_AI_GATEWAY_API_KEY=
CADRE_AI_MODEL=cadre-free
CADRE_AI_TIMEOUT_MS=90000

# Phase 1 external route: LiteLLM -> OpenRouter free router.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
CADRE_OPENROUTER_MODEL=openrouter/openrouter/free
OR_SITE_URL=http://localhost:3000
OR_APP_NAME=CADRE

# Optional future local/self-hosted lane. Inactive until configured in LiteLLM.
CADRE_LOCAL_MODEL=
CADRE_LOCAL_API_BASE=http://127.0.0.1:11434
CADRE_LOCAL_API_KEY=

# Optional future premium/direct lane. None is active in Phase 1.
CADRE_PREMIUM_MODEL=
CADRE_PREMIUM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Public origin used for exact same-origin mutation checks.
APP_URL=http://localhost:3000

# Optional test-only deterministic provider. Never enable in production.
CADRE_ENABLE_TEST_PROVIDER=false
