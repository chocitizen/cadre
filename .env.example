# Local Docker development. Copy to .env; never commit populated credentials.
CADRE_ENV=development
CADRE_APP_NAME=LANSEIR
CADRE_DB_PASSWORD=replace_with_a_strong_unique_password
CADRE_DATABASE_URL=postgresql+psycopg://cadre:replace_with_url_encoded_password@db:5432/cadre
CADRE_OPERATIONS_STATE_PATH=/tmp/lanseir-mission-control.json
CADRE_RELEASE_ID=development
CADRE_API_TOKENS_JSON={"founder":"replace_with_32_plus_random_characters","mission_control":"replace_with_32_plus_random_characters","al":"replace_with_32_plus_random_characters","invictus":"replace_with_32_plus_random_characters","porter":"replace_with_32_plus_random_characters","griot":"replace_with_32_plus_random_characters","sentinel":"replace_with_32_plus_random_characters"}
CADRE_PUBLIC_URL=http://127.0.0.1:8000
CADRE_ADMIN_EMAILS=owner@example.com
CADRE_EXPOSE_DEVELOPMENT_TOKENS=false
CADRE_GATEWAY_STATE_KEY=canonical
CADRE_GITHUB_REPOSITORY=chocitizen/cadre
CADRE_GITHUB_TOKEN=
CADRE_RAILWAY_PROJECT_ID=
CADRE_RAILWAY_ENVIRONMENT=staging
CADRE_RAILWAY_TOKEN=
CADRE_HOSTINGER_SSH_HOST=
CADRE_HOSTINGER_OPERATIONS_ENABLED=false
CADRE_LAST_VALIDATED_COMMIT=
CADRE_ROLLBACK_REFERENCE=archive/pre-lanseir-autonomy-2026-08-28
CADRE_AI_PROVIDER=local
CADRE_AI_MODEL=lanseir-reflection-v1
CADRE_AI_BASE_URL=https://litellm.internal/v1
CADRE_AI_API_KEY=
