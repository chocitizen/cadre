# CADRE selects an embedded PostgreSQL-compatible store locally when DATABASE_URL is absent.
# Production should use a private PostgreSQL connection string.
DATABASE_URL=
CADRE_DB_PATH=./data/cadre

# Server-only OpenAI configuration. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
CADRE_AI_PROVIDER=openai

# Public origin used for exact same-origin mutation checks.
APP_URL=http://localhost:3000

# Optional test-only deterministic provider. Never enable in production.
CADRE_ENABLE_TEST_PROVIDER=false
